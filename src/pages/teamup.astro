<script>
  const sections = Array.from(
    document.querySelectorAll(".teamup-page section[id]"),
  );
  const sectionLinks = Array.from(
    document.querySelectorAll("[data-section-link]"),
  );

  const setActiveSection = (activeId: string) => {
    sectionLinks.forEach((link) => {
      const isActive = link.getAttribute("data-section-link") === activeId;

      link.classList.toggle("is-active", isActive);

      if (isActive) {
        link.setAttribute("aria-current", "true");
      } else {
        link.removeAttribute("aria-current");
      }
    });
  };

  let activeSectionUpdateFrame = 0;

  const updateActiveSection = () => {
    activeSectionUpdateFrame = 0;

    let activeSectionId = sections[0].id;
    const activationOffset = 120;

    sections.forEach((section) => {
      if (section.getBoundingClientRect().top <= activationOffset) {
        activeSectionId = section.id;
      }
    });

    setActiveSection(activeSectionId);
  };

  const requestActiveSectionUpdate = () => {
    if (activeSectionUpdateFrame !== 0) {
      return;
    }

    activeSectionUpdateFrame =
      window.requestAnimationFrame(updateActiveSection);
  };

  window.addEventListener("scroll", requestActiveSectionUpdate, {
    passive: true,
  });
  window.addEventListener("resize", requestActiveSectionUpdate);

  requestActiveSectionUpdate();
</script>

